# Developer identity
USER_ID=developer-name
DEVICE_ID=developer-device

# Folder that contains one subfolder per managed project.
# Each managed project subfolder must contain project.yaml.
PROJECTS_PATH=/Users/you/company-projects

# Central AI Dev Management API reachable from Docker Desktop.
CENTRAL_URL=http://host.docker.internal:8080
COLLECTOR_TOKEN=replace-with-a-random-token

# Periodic local scan interval.
INTERVAL_SECONDS=900

# MCP identity for the coding agent using this endpoint.
# Change these values when this MCP instance is dedicated to TRAE/Hermes/etc.
AGENT_VENDOR=OpenAI
AGENT_NAME=Codex
AGENT_INSTANCE_ID=codex-main
MCP_PORT=6410

# Optional local LLM used for document/git-change analysis.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=60
ALLOW_REMOTE_ANALYSIS_ENDPOINT=false
